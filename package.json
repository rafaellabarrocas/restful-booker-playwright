{
  "name": "restful-booker-cypress",
  "version": "0.1.0",
  "private": true,
  "description": "Automated test suite for Restful Booker Platform (automationintesting.online)",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:smoke": "cypress run --expose grepTags=@smoke,grepFilterSpecs=true",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "cypress": "^16.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.4",
    "prettier": "^3.10.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
